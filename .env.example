# 复制为 .env 后填写。不要把真实密钥提交到仓库。
NODE_ENV=development
PORT=3000
ENABLE_TEST_MODE=true
TEST_OPENID=editor_default
TOKEN_SECRET=replace-with-a-random-secret

# 本地直连或 SSH 隧道连接串
DATABASE_URL=postgresql://slime_dev_user:password@127.0.0.1:15432/slime_dev
PG_POOL_MAX=5
PG_SSL=false

WX_APPID=
WX_SECRET=

# 日志
HTTP_LOG_DETAIL_MODE=detailed
HTTP_LOG_INCLUDE_BODY=false
HTTP_LOG_INCLUDE_RESPONSE=false
